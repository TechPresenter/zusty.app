# =====================================================================
# Zusty Backend — environment configuration
# Copy to `.env` and fill in. NEVER commit the real .env file.
# On Hostinger place this file OUTSIDE public_html (see docs/DEPLOYMENT.md).
# =====================================================================

# ---------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------
APP_NAME="Zusty"
APP_ENV=production                 # local | staging | production
APP_DEBUG=false                    # NEVER true in production
APP_URL=https://zustee.com
API_URL=https://zustee.com/api
ADMIN_URL=https://zustee.com/admin
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en

# ---------------------------------------------------------------------
# Database (MySQL)
# ---------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=zuste_marketplace
DB_USER=zuste_user
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_SOCKET=

# ---------------------------------------------------------------------
# Security
# Generate each secret with:  php -r "echo bin2hex(random_bytes(32));"
# ---------------------------------------------------------------------
JWT_SECRET=
JWT_ISSUER=zustee.com
JWT_AUDIENCE=zuste-app
JWT_ACCESS_TTL=3600                # seconds
JWT_REFRESH_TTL=2592000            # seconds (30 days)

# 64 hex characters — used for AES-256-GCM encryption of KYC / bank data.
# Changing this makes previously encrypted values unreadable.
APP_ENCRYPTION_KEY=

# Session + CSRF for the admin panel
SESSION_NAME=zuste_admin_session
SESSION_LIFETIME=7200              # seconds
SESSION_SECURE=true                # requires HTTPS
SESSION_SAMESITE=Lax

# ---------------------------------------------------------------------
# CORS — comma separated, exact origins only (no wildcards in production)
# ---------------------------------------------------------------------
# Addresses (or CIDR blocks, comma separated) whose X-Forwarded-For header is
# believed. Leave EMPTY when the server is reached directly. Behind nginx on the
# same host use 127.0.0.1; behind Cloudflare add their published ranges.
# Setting this wrongly makes every IP-based rate limit and allow-list spoofable.
TRUSTED_PROXIES=

CORS_ALLOWED_ORIGINS=https://zustee.com,https://www.zustee.com,https://app.zustee.com

# ---------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------
STORAGE_DRIVER=local               # local | firebase
UPLOAD_PATH=public/uploads
UPLOAD_URL=/uploads
STORAGE_PATH=storage
LOG_CHANNEL=daily                  # daily | single | database

# ---------------------------------------------------------------------
# Firebase
# Download the service account JSON from the Firebase console and place it
# outside public_html, then point FIREBASE_CREDENTIALS at it.
# ---------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_CREDENTIALS=../firebase-service-account.json
FIREBASE_STORAGE_BUCKET=

# ---------------------------------------------------------------------
# Payment gateways
# ---------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cashfree Payments. The secret key also signs webhooks.
# CASHFREE_MODE is `sandbox` or `production`.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_MODE=sandbox
CASHFREE_RETURN_URL=

# ---------------------------------------------------------------------
# Mail (Hostinger business SMTP)
# ---------------------------------------------------------------------
MAIL_DRIVER=smtp                   # smtp | mail | log
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl                # ssl | tls | none
MAIL_USERNAME=no-reply@zustee.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@zustee.com
MAIL_FROM_NAME="Zusty"

# ---------------------------------------------------------------------
# SMS
# ---------------------------------------------------------------------
SMS_ENABLED=false
SMS_PROVIDER=msg91                 # msg91 | twilio | textlocal
SMS_API_KEY=
SMS_SENDER_ID=ZUSTEP
SMS_OTP_TEMPLATE_ID=

# ---------------------------------------------------------------------
# Cron — the secret is required by /api/v1/cron/* HTTP triggers.
# Prefer the CLI runner (php scripts/cron.php <job>) where possible.
# ---------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------
BACKUP_PATH=storage/backups
BACKUP_RETENTION_DAYS=14
MYSQLDUMP_PATH=mysqldump
