<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The API, images and push all need the network. Flutter only adds this
         permission to the debug and profile manifests, so a release build
         without it here would rely on a plugin happening to merge it in. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Permissions libraries merge in that the app never uses, removed so the
         install page and the Play Data safety form only list what Zusty does.
         Biometrics come with flutter_secure_storage (the app never asks for a
         fingerprint); the advertising ID and ad-services attribution come with
         Google measurement libraries (the app shows no ads and does not use
         Analytics). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" tools:node="remove"/>
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove"/>
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove"/>

    <!-- Voice search. RECORD_AUDIO is the runtime permission the speech
         recogniser needs; the app asks for it the first time somebody taps the
         microphone and never at launch. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!-- "Use my current location" in the city picker. Coarse is enough to snap
         to the nearest city, and asks for less than precise location. Without
         a location permission declared here, Geolocator refuses outright. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- Android 11 (API 30) package visibility. Without this <queries> block
         the recogniser is invisible to us and initialize() returns false on
         every modern device, so the microphone button would simply never
         appear — with no error to explain why. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>

    <!-- Backups leave out the response cache and the encrypted token store
         (res/xml), so cached account data cannot come back through a restore
         after a sign-out or an account deletion. dataExtractionRules applies
         on Android 12 and later, fullBackupContent on Android 11 and earlier. -->
    <application
        android:label="Zusty"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- The backend sends every push with click_action
                 FLUTTER_NOTIFICATION_CLICK (FirebaseService::sendToToken).
                 Android opens a tapped notification by that action, so without
                 an activity that answers to it the tap does nothing at all. -->
            <intent-filter>
                <action android:name="FLUTTER_NOTIFICATION_CLICK"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <!-- The backend sends every push with channel_id "zuste_default"
             (FirebaseService::sendToToken). MainActivity creates the channel,
             and naming it here keeps notifications out of the SDK's unnamed
             "Miscellaneous" fallback channel. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="zuste_default" />
        <!-- The status bar draws a notification icon as a white silhouette, so
             the full-colour launcher icon would be a white blob. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
        <!-- Crash reports are collected only once the app switches collection
             on, which it does in release builds (CrashReporting). Without this
             a debug build would report too. -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />

        <!-- Geolocator merges in a foreground service (type "location") for
             position streams that keep running in the background. The app
             only asks for one coarse fix with getCurrentPosition(), which
             never uses it, so it is removed: the release manifest then
             declares no foreground service and Play asks for no
             foreground-service declaration. The plugin's attempt to bind it
             fails quietly and one-off fixes work as before. -->
        <service
            android:name="com.baseflow.geolocator.GeolocatorLocationService"
            tools:node="remove" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
